{
  "functions": [
    {
      "source": "functions",
      "codebase": "push",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "test",
        "rules-test",
        "e2e",
        "*.local",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firestore-debug.log",
        "ui-debug.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    }
  }
}
