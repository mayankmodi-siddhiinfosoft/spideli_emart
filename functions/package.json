{
  "name": "spideli-functions",
  "private": true,
  "description": "Spideli Cloud Functions (codebase \"push\"): scheduledOrderNotifier pushes a store when a scheduled order becomes due.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/",
    "deploy": "firebase deploy --only functions:push:scheduledOrderNotifier --project spideli-870b0",
    "logs": "firebase functions:log --only scheduledOrderNotifier --project spideli-870b0"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
